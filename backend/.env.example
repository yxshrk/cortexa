# ─── Backend env (Yash's FastAPI) ────────────────────────────────
# Copy to backend/.env and fill in. Real values go in 1Password.

# ── Supabase ────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
# Backend uses the SERVICE-ROLE key (bypasses RLS).
# NEVER set service-role on the frontend.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role secret, eyJ...>

# ── Demo auth gate ──────────────────────────────────────────────
# Same value as NEXT_PUBLIC_DEMO_TOKEN on frontend. Rotated demo-day.
DEMO_TOKEN=<rotate-this>

# ── OpenAI ──────────────────────────────────────────────────────
# Used for: /rt/token (Realtime client_secrets), /context/query embeddings,
# /ingest/hyperspell embeddings, voice summarizer if backend takes over.
OPENAI_KEY=sk-proj-...

# ── Anthropic (Claude) ──────────────────────────────────────────
# Used by synthesizer + categorizer + action_drafter (the 3 Claude calls in /plan/generate).
ANTHROPIC_KEY=sk-ant-...

# ── Hyperspell ──────────────────────────────────────────────────
# From app.hyperspell.com. Per-user client constructed with project's hyperspell_user_id.
HYPERSPELL_KEY=hsk_...

# ── Executors ───────────────────────────────────────────────────
# Linear: a personal API token from linear.app/settings/api scoped to your sandbox project.
LINEAR_TOKEN=lin_api_...
LINEAR_TEAM_ID=<from linear, team you create issues in>

# GitHub: PAT scoped to the demo repo. Need 'repo' for PR creation.
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=<owner>
GITHUB_REPO=<repo>
GITHUB_BASE_BRANCH=main

# Devin: API token from app.devin.ai. Hackathon credits via Tatiana.
DEVIN_TOKEN=...

# ── App ─────────────────────────────────────────────────────────
ENV=dev
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://<your-vercel>.vercel.app

# ── Optional: Hyperspell GitHub beta toggle ─────────────────────
# Set to false if your Hyperspell account doesn't have GitHub beta access.
# /plan/generate falls back to backend/fixtures/seed_code_refs.json.
HYPERSPELL_GITHUB_AVAILABLE=true
