NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co

# The PUBLISHABLE / anon key (sb_publishable_*). NEVER the secret key.
# Either env var name works — use whichever is most recent on your project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (legacy alias, also supported by lib/supabase.ts)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_TOKEN=<rotate-tonight>

# Server-only — used by Yudong's /api/voice/summarize Route Handler
OPENAI_API_KEY=<sk-...>
